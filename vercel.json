{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index.html",      "destination": "/",           "permanent": true },
    { "source": "/app.html",        "destination": "/app",        "permanent": true },
    { "source": "/band.html",       "destination": "/band",       "permanent": true },
    { "source": "/event.html",      "destination": "/event",      "permanent": true },
    { "source": "/onboarding.html", "destination": "/onboarding", "permanent": true },
    { "source": "/invite.html",     "destination": "/invite",     "permanent": true },
    { "source": "/billing.html",    "destination": "/billing",    "permanent": true },
    { "source": "/admin.html",      "destination": "/admin",      "permanent": true }
  ],
  "rewrites": [
    { "source": "/app",        "destination": "/app.html" },
    { "source": "/band",       "destination": "/band.html" },
    { "source": "/event",      "destination": "/event.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" },
    { "source": "/invite",     "destination": "/invite.html" },
    { "source": "/billing",    "destination": "/billing.html" },
    { "source": "/admin",      "destination": "/admin.html" }
  ]
}
